---
import { useTranslations, dirFor, type Lang } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const dir = dirFor(lang);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{t("meta.title")}</title>
    <meta name="description" content={t("meta.description")} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t("meta.title")} />
    <meta property="og:description" content={t("meta.description")} />
    <meta property="og:image" content="https://glyph.md/assets/hero.png" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The accent as a literal: a meta tag cannot read a custom property. */}
    <meta name="theme-color" content="#2f4fe0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#6d8bff" media="(prefers-color-scheme: dark)" />

    {
      lang === "fa" && (
        <Fragment>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700&display=swap"
          />
        </Fragment>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t("nav.skip")}</a>
    <slot />
  </body>
</html>
