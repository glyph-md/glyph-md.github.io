---
import { useTranslations, localizedPath, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const download = `${localizedPath(lang, "/")}#download`;
const repo = "https://github.com/hamidfzm/glyph";
---
<section class="hero">
  <div class="container hero-inner">
    <span class="badge"><span class="dot"></span>{t("hero.badge")}</span>
    <h1>{t("hero.title")}</h1>
    <p class="lead">{t("hero.subtitle")}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={download}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"></path>
        </svg>
        {t("hero.cta.download")}
      </a>
      <a class="btn btn-ghost" href={repo} rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.37-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"></path>
        </svg>
        {t("hero.cta.github")}
      </a>
    </div>
    <p class="hero-note">{t("hero.note")}</p>
  </div>
  <div class="container">
    <div class="hero-shot">
      <img src="/assets/hero.png" alt="Glyph rendering a markdown document" width="1731" height="909" fetchpriority="high" />
    </div>
  </div>
</section>
